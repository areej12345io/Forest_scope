# Copy this file to .env and fill it in. Never commit .env.
DB_NAME=forestscope
DB_USER=forestuser
DB_PASSWORD=choose-a-password
DB_HOST_PORT=5433

# Your Google Cloud project that is registered for Earth Engine
EE_PROJECT=your-earth-engine-project-id


# Free Mapbox public token for the base map (create one at mapbox.com). Restrict it to your site URL.
MAPBOX_TOKEN=
